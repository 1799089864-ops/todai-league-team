{
	"name": "todai-league",
	"private": true,
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@11.25.0",
	"scripts": {
		"dev": "LAUNCH_EDITOR=zed vite dev",
		"clean:cf": "rm -rf .svelte-kit/cloudflare .svelte-kit/output",
		"gen": "pnpm run clean:cf && wrangler types --env-file .env.wrangler-types",
		"gen:check": "pnpm run clean:cf && wrangler types --env-file .env.wrangler-types --check",
		"build": "pnpm run gen:check && vite build",
		"preview": "wrangler dev --port 4173",
		"preview:e2e": "wrangler dev --port 4173 --persist-to .wrangler/e2e-state",
		"test:e2e:db:reset": "rm -rf .wrangler/e2e-state && wrangler d1 migrations apply todai-league --local --persist-to .wrangler/e2e-state",
		"test:e2e:server": "pnpm test:e2e:db:reset && pnpm build && wrangler dev --port 4173 --persist-to .wrangler/e2e-state",
		"prepare": "svelte-kit sync && lefthook install || echo ''",
		"check": "pnpm run gen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:ci": "pnpm run gen:check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm run gen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:related": "vitest related --run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test --project=chromium",
		"test:e2e:full": "playwright test --project=full-sim",
		"db:reset:local": "rm -rf .wrangler/state/v3/d1 && wrangler d1 migrations apply todai-league --local",
		"db:seed": "tsx scripts/seed.ts",
		"db:seed:staging": "tsx scripts/seed.ts --target=staging",
		"db:seed:prod": "tsx scripts/seed.ts --target=prod",
		"db:seed:reset": "rm -rf .wrangler/state/v3/d1 && pnpm db:seed",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:deploy": "pnpm run db:migrate:prod",
		"db:studio": "drizzle-kit studio",
		"db:migrate:staging": "wrangler d1 migrations apply todai-league-staging --config wrangler.staging.jsonc --remote",
		"db:migrate:prod": "wrangler d1 migrations apply todai-league --config wrangler.jsonc --remote",
		"backup:dev": "wrangler dev -c workers/backup/wrangler.jsonc --port 4174",
		"backup:check": "tsc -p workers/backup/tsconfig.json",
		"backup:deploy": "wrangler deploy -c workers/backup/wrangler.jsonc",
		"auth:schema": "pnpm dlx auth@latest generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"doctor": "node scripts/doctor.mjs",
		"preflight": "node scripts/doctor.mjs",
		"cf:ensure-secrets": "node scripts/ensure-cloudflare-secrets.mjs",
		"cf:ensure-secrets:staging": "node scripts/ensure-cloudflare-secrets.mjs --config wrangler.staging.jsonc",
		"cf:deploy-worker": "wrangler deploy -c wrangler.jsonc",
		"cf:deploy-worker:staging": "wrangler deploy -c wrangler.staging.jsonc",
		"deploy": "pnpm run deploy:prod",
		"deploy:prod": "node scripts/deploy.mjs --target prod",
		"deploy:staging": "node scripts/deploy.mjs --target staging",
		"deploy:workers-builds": "node scripts/deploy-workers-builds.mjs",
		"deploy:button": "node scripts/deploy-button.mjs"
	},
	"cloudflare": {
		"bindings": {
			"BETTER_AUTH_SECRET": {
				"description": "Generated automatically on first deploy by scripts/ensure-cloudflare-secrets.mjs. Do not rotate unless you intentionally want to invalidate existing sessions."
			},
			"BETTER_AUTH_URL": {
				"description": "Optional. Leave unset to use the request origin automatically. Set only when forcing a canonical auth origin."
			},
			"BACKUP_WORKER_URL": {
				"description": "Optional. Public URL for the backup Worker if the backup feature is deployed."
			},
			"BACKUP_DOWNLOAD_TOKEN": {
				"description": "Optional. Token used by the backup settings page when the backup Worker is deployed."
			}
		}
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.21.2",
		"@cloudflare/workers-types": "^5.20260813.1",
		"@content-collections/core": "^0.15.2",
		"@content-collections/markdown": "^0.1.4",
		"@content-collections/vite": "^0.3.0",
		"@eslint/config-helpers": "^0.7.0",
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.31.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/d3": "^7.4.3",
		"@types/d3-array": "^3.2.2",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.8",
		"@types/hast": "^3.0.5",
		"@types/node": "^26.2.0",
		"@vitest/browser-playwright": "^4.1.10",
		"@vitest/coverage-istanbul": "4.1.10",
		"@vitest/coverage-v8": "^4.1.10",
		"better-auth": "1.6.27",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"lefthook": "^2.1.10",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"remark-gfm": "^4.0.1",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"unist-util-visit": "^5.1.0",
		"vite": "^8.2.1",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.0.0",
		"wrangler": "^4.122.0"
	},
	"dependencies": {
		"@cloudflare/puppeteer": "^1.3.0",
		"@dnd-kit/svelte": "^0.5.0",
		"@fontsource/line-seed-jp": "^5.3.0",
		"@total-typescript/ts-reset": "^0.6.1",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"d3": "^7.9.0",
		"d3-array": "^3.2.4",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"hono": "^4.13.5",
		"partyserver": "^0.5.10",
		"partysocket": "^1.3.0",
		"rehype-slug": "^6.0.0",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"valibot": "^1.4.2"
	}
}
